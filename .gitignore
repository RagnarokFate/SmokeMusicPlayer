# This .gitignore file is based on Unity's recommended .gitignore,
# with additions for Speckit/Gemini specific files.

# Unity generated files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Pp]rojectSettings/UserSettings.asset
/Assets/[Ss]cenes/SampleScene.unity.meta
/Assets/[Ss]cenes/SampleScene.unity

# Visual Studio files
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity Asset Store metadata
.DS_Store
.history

# Crashlytics by Google
com.crashlytics.sdk.*
Crashlytics-*.txt

# Autogenerated VS/Rider files
/Assets/Plugins/Editor/JetBrains/
.idea/

# Speckit/Gemini specific files
.gemini/
.specify/
specs/
GEMINI.md
debug_img.png
Assets/Project/prd.md
Assets/Project/prd_unfinished.md
*.md.meta

